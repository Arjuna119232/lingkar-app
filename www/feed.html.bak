<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Feed - Lingkar</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/animations.css">
<link rel="stylesheet" href="css/responsive.css">
</head>
<body>
  <div id="app-header"></div>
  <div class="container page">
    <div class="tabs">
      <button class="active" data-filter="all">Semua</button>
      <button data-filter="inner">Inner</button>
      <button data-filter="close">Close</button>
      <button data-filter="community">Community</button>
    </div>
    <div id="feed-list" class="stagger" style="overflow-y:auto"></div>
  </div>
  <div id="bottom-nav"></div>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/local-storage.js"></script>
  <script src="js/supabase.js"></script>
  <script src="js/utils.js"></script>
  <script src="js/error-handler.js"></script>
  <script src="js/app.js"></script>
  <script src="js/feed.js"></script>
  <script>Feed.init();</script>
</body>
</html>
