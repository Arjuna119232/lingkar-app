<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pengaturan - Lingkar</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/animations.css">
</head>
<body>
  <div class="container page no-nav no-header">
    <a href="profile.html" class="text-dim"><i class="fa-solid fa-arrow-left"></i> Kembali</a>
    <h1 style="font-size:18px;font-weight:800;margin:16px 0">Pengaturan</h1>

    <div class="card" style="padding:0 14px">
      <a href="edit-profile.html" class="list-row"><i class="leading fa-solid fa-user"></i><div class="row-text"><div class="t1">Edit Profil</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="edit-profile.html" class="list-row"><i class="leading fa-solid fa-envelope"></i><div class="row-text"><div class="t1">Ganti Email</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="forgot-password.html" class="list-row"><i class="leading fa-solid fa-lock"></i><div class="row-text"><div class="t1">Ganti Password</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="notification-settings.html" class="list-row"><i class="leading fa-solid fa-bell"></i><div class="row-text"><div class="t1">Notifikasi</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="privacy-policy.html" class="list-row"><i class="leading fa-solid fa-shield-halved"></i><div class="row-text"><div class="t1">Privasi</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <select style="background:var(--surface-2);color:var(--text);border:1px solid var(--border);border-radius:8px;padding:4px">
          <option>Indonesia</option><option>English</option>
        </select>
      </div>
      <div class="list-row">
        <i class="leading fa-solid fa-moon"></i>
        <div class="row-text"><div class="t1">Tema Gelap</div></div>
        <label class="switch"><input type="checkbox" id="theme-switch"><span class="slider"></span></label>
      </div>
      <a href="developer.html" class="list-row">
        <i class="leading fa-solid fa-user-tie"></i>
        <div class="row-text">
          <div class="t1">Developer</div>
          <div class="t2" style="font-size:12px">0xmahen</div>
        </div>
        <i class="chev fa-solid fa-chevron-right"></i>
      </a>
      <a href="about.html" class="list-row"><i class="leading fa-solid fa-circle-info"></i><div class="row-text"><div class="t1">Tentang</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="help.html" class="list-row"><i class="leading fa-solid fa-circle-question"></i><div class="row-text"><div class="t1">Bantuan</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="contact.html" class="list-row"><i class="leading fa-solid fa-headset"></i><div class="row-text"><div class="t1">Kontak</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="privacy-policy.html" class="list-row"><i class="leading fa-solid fa-file-shield"></i><div class="row-text"><div class="t1">Kebijakan Privasi</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
      <a href="terms.html" class="list-row"><i class="leading fa-solid fa-file-contract"></i><div class="row-text"><div class="t1">Syarat & Ketentuan</div></div><i class="chev fa-solid fa-chevron-right"></i></a>
    </div>

    <button class="btn btn-outline mt-24" id="btn-logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
    <button class="btn-ghost mt-16" id="btn-delete-account" style="background:none;border:none;color:var(--danger);width:100%;padding:10px">Hapus Akun</button>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/local-storage.js"></script>
  <script src="js/supabase.js"></script>
  <script src="js/utils.js"></script>
  <script src="js/error-handler.js"></script>
  <script src="js/app.js"></script>
  <script src="js/settings.js"></script>
  <script>Settings.init();</script>
</body>
</html>
